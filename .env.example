# ====================================================================
#  Universal Video Downloader Pro - Production Environment Variables
# ====================================================================

# Web Server Binding
HOST=0.0.0.0
PORT=5000

# Anti-Ban Rotating Residential / Datacenter Proxy (Optional)
# Format: http://user:pass@host:port or socks5://host:port
PROXY_URL=

# Temporary Storage In-Memory Processing (/dev/shm RAM disk on Linux)
# Set to 'true' to process all downloads in RAM with zero disk wear & instant I/O
USE_RAM_DISK=false

# VPS Temporary Media Retention TTL (in seconds, default: 900 = 15 minutes)
FILE_RETENTION_SECONDS=900

# Concurrency & Performance
MAX_WORKERS=4
RATE_LIMIT_PER_MINUTE=60
