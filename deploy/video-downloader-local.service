[Unit]
Description=Universal Video Downloader Pro - Local Server
After=network.target

[Service]
Type=simple
User=sumon
WorkingDirectory=/var/www/video-downloader
Environment=PYTHONUNBUFFERED=1
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=FILE_RETENTION_SECONDS=900
ExecStart=/var/www/video-downloader/server/venv/bin/python3 server/main.py --host 127.0.0.1 --port 5000 --no-browser
Restart=always
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
