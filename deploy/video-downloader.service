[Unit]
Description=Universal Video Downloader Pro - Production Server
After=network.target

[Service]
Type=simple
User=root
# Change WorkingDirectory to your repository location on the VPS (e.g. /var/www/video-downloader)
WorkingDirectory=/var/www/video-downloader

# Environment configuration
Environment=PYTHONUNBUFFERED=1
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=FILE_RETENTION_SECONDS=900
EnvironmentFile=-/var/www/video-downloader/.env

# Execute production server using virtualenv python
ExecStart=/var/www/video-downloader/server/venv/bin/python3 server/main.py --host 127.0.0.1 --port 5000 --no-browser

# Automatic restart on failure
Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
